# ---------------------------------------------------------------------------
# Low-spec PC (no NVIDIA GPU, little disk): run the API only.
#
#   docker build --build-arg GPU=0 -t model-runner:api .   # ~250 MB image, no torch
#   docker run --rm -p 127.0.0.1:8000:8000 --env-file .env model-runner:api
#
# Don't use `docker compose up` here: it builds the full GPU image
# (several GB of torch/CUDA) and won't start without an NVIDIA GPU.
#
# What works: /docs, /health, /v1/models, /v1/stats, request validation, job queue.
# What doesn't: actual generation. Jobs fail because torch isn't installed,
# so no model weights are ever downloaded and the model settings below don't matter.
# ---------------------------------------------------------------------------

# Docker only: host address the API port binds to. Keep 127.0.0.1 in production too:
# the backend reaches it through an SSH tunnel to the GPU host's loopback.
# BIND_ADDR=127.0.0.1

APP_NAME=Model Runner
MODELS_CONFIG_PATH=config/models.yaml
OUTPUTS_DIR=outputs
DEFAULT_IMAGE_MODEL=sdxl-placeholder

# Used when a video request has no `model`. Ids from config/models.yaml:
#   wan2.2-ti2v-5b              text-to-video + image-to-video, ~24 GB GPU (default)
#   wan2.2-t2v-a14b             text-to-video only; always CPU-offloaded, needs ~80 GB system RAM
#   wan2.2-i2v-a14b             image-to-video only (`image` required); same as above
#   hunyuanvideo-1.5-720p-t2v   text-to-video only, 8.3B
#   hunyuanvideo-1.5-720p-i2v   image-to-video only (`image` required), 8.3B
# Any request can still pick another one with `model`. Only one stays loaded; switching reloads weights.
# Pick a model that does text-to-video, or requests without `image` get a 400.
#
# For a smaller GPU (~8 GB) later, Wan-AI/Wan2.1-T2V-1.3B-Diffusers
# (text-to-video only, 832x480) can be added to config/models.yaml with adapter: wan, modes: [t2v]. Untested.
# For testing: pruna-test/wan-t2v-tiny-random (~1.5 GB, 832x480 text-to-video only, adapter: wan, modes: [t2v]).
DEFAULT_VIDEO_MODEL=wan2.2-ti2v-5b

# Longest video a request may ask for (241 = 10 s at 24 fps). The models are trained at 81-121 frames:
# longer works but quality drifts, denoise time grows faster than length, and memory grows with it.
MAX_FRAMES=241

# Needed on 24 GB GPUs; set to false on ~40 GB+ GPUs. Ignored without a GPU.
CPU_OFFLOAD=true
